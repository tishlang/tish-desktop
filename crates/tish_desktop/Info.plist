<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSUserNotificationAlertStyle</key>
  <string>alert</string>
  <key>NSUserNotificationsUsageDescription</key>
  <string>Tish Desktop uses notifications for alerts and dock badges.</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.tishlang.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>tish-desktop</string>
      </array>
    </dict>
  </array>
  <!--
    Tray-only / agent apps: set LSUIElement to true so the process has no Dock
    icon or menu bar app name (menu-bar status item only). Leave false/absent
    for normal windowed desktop apps (default for tish-desktop examples).
  -->
  <key>LSUIElement</key>
  <false/>
</dict>
</plist>
