import { exit, env, cwd } from "tish:process"
import { exec } from "tish:process"
import {
  flagValue,
  joinPath,
  pathExists,
  q,
  resolveTish,
} from "../paths.tish"

export fn runDoctor(args) {
  let platform = flagValue(args, "--platform")
  if (platform === null && env !== null) platform = env["TISH_PLATFORM"]
  if (platform === null || platform === undefined) platform = "macos"
  let surface = flagValue(args, "--surface")
  if (surface === null && env !== null) surface = env["TISH_SURFACE"]
  if (surface === null || surface === undefined) surface = "webview"

  let tish = resolveTish()
  console.log("tish-desktop doctor")
  console.log("  platform: " + platform)
  console.log("  surface:  " + surface)
  console.log("  tish:     " + tish)

  let probe = flagValue(args, "--resolve")
  if (probe === null) probe = "./Button"
  let importer = flagValue(args, "--importer")
  if (importer === null) {
    let here = cwd()
    importer = joinPath(here, "src/main.tish")
    if (!pathExists(importer)) importer = joinPath(here, "ui/main.tish")
    if (!pathExists(importer)) importer = joinPath(here, "app/App.tish")
  }

  console.log("  resolve:  " + probe + " (importer " + importer + ")")
  let cmd = tish + " resolve-id " + q(probe) + " --importer " + q(importer)
  cmd = cmd + " --platform " + q(platform) + " --surface " + q(surface)
  exec("sh -c " + q(cmd + " || echo '(resolve-id failed — rebuild tish CLI with platform resolve)'"))

  console.log("")
  console.log("Caps (desktop host):")
  console.log("  notification.*  Tauri / apple UN / ms·lin notify-rust / ios UN / web stub")
  console.log("  state.*         Full (tish_broker; path + revision); ios.invoke + brokerInvoke")
  console.log("  store.*         Full when plugins.store (persisted; not state.*)")
  console.log("  webview.*       Partial (Tauri load/postMessage; apple WK via macos.webview*)")
  console.log("  tray.*          Desktop-only → unsupported on web/ios")
  console.log("  createSurface.native  platform-apple | platform-ms | platform-lin")
  console.log("")
  console.log("Tip: alias as `tish-desktop doctor` (plan name: tish app doctor).")
  console.log("iOS sim: tish-desktop ios --example hello-ios  (or tish-apple npm run example:hello-ios)")
  console.log("HMR: platform file edits reload; switching TISH_PLATFORM/SURFACE needs Vite restart.")
  console.log("See docs/UNIFIED_APP.md, docs/HYBRID.md, docs/UPSTREAM_OPEN.md")
  exit(0)
}
