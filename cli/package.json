{
  "name": "@tish-desktop/cli",
  "version": "0.1.0",
  "description": "Tish Desktop CLI — init, dev, build, info, icon, distribute",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/tish-desktop.git",
    "directory": "cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tish-desktop": "bin/tish-desktop.js"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "tish": {
    "source": "./src/main.tish",
    "features": ["process", "fs"]
  },
  "scripts": {
    "dev": "tish run --feature process,fs src/main.tish",
    "build": "tish build --feature process,fs --target native --native-backend rust src/main.tish -o dist/tish-desktop",
    "start": "node bin/tish-desktop.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tish",
    "desktop",
    "tauri",
    "cli"
  ]
}
