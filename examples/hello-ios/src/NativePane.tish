// Full-native demo pane — same broker features as the webview demo.

import { Button } from "./Button"

export fn NativePane(props) {
  let count = props.count
  let setCount = props.setCount
  let note = props.note
  let setNote = props.setNote
  let flag = props.flag
  let setFlag = props.setFlag
  let docId = props.docId
  let shared = props.shared
  let onSelect = props.onSelect
  let onRefresh = props.onRefresh
  let onNotify = props.onNotify
  let onAlert = props.onAlert
  let onCount = props.onCount
  let onNote = props.onNote
  let onFlag = props.onFlag

  return (
    <div>
      <h1>Native + Broker</h1>
      <p>{"Same features as the Webview pane via host tags + invoke (no Tauri)."}</p>
      <image src={"star.fill"} symbol={true} height={28} />
      <space height={8} />
      <textinput
        placeholder={"Note"}
        value={note}
        onChange={(v) => {
          setNote(v)
          if (onNote) {
            onNote(v)
          }
        }}
      />
      <space height={8} />
      <row>
        <span>{"Toggle"}</span>
        <toggler
          checked={flag}
          onChange={(v) => {
            setFlag(v)
            if (onFlag) {
              onFlag(v)
            }
          }}
        />
      </row>
      <rule />
      <div>
        <span>{"Count: " + count + " note=" + note + " flag=" + flag}</span>
        <button
          onClick={() => {
            let n = count + 1
            setCount(n)
            if (onCount) {
              onCount(n)
            }
          }}
        >
          {"Increment"}
        </button>
      </div>
      <div>
        <span>{"docId: " + docId + " shared=" + shared}</span>
        <Button label={"Doc A"} onPress={() => onSelect("a")} />
        <Button label={"Doc B"} onPress={() => onSelect("b")} />
        <button onClick={onRefresh}>{"Refresh state"}</button>
        <button onClick={onNotify}>{"Notify"}</button>
        <button onClick={onAlert}>{"Alert"}</button>
      </div>
    </div>
  )
}
