// Native chrome demo — full broker surface for OS chrome + advanced APIs.
import { run, createWindow } from "cargo:tishlang_desktop"

createWindow({
  label: "main",
  url: "http://localhost:5175/",
  title: "Tish Desktop — Native Chrome",
  width: 960,
  height: 720,
  titleBarStyle: "visible",
  hiddenTitle: false
})

run({
  plugins: {
    dialog: true,
    tray: true,
    menu: true,
    deepLink: true,
    opener: true,
    notification: true,
    clipboard: true,
    globalShortcut: true,
    windowState: true,
    os: true,
    store: true,
    autostart: true,
    process: true,
    shell: true,
    http: true,
    auth: true,
    singleInstance: false
  },
  shellAllow: [{ name: "echo", cmd: "echo", argsPrefix: [] }],
  httpAllow: ["example.com"],
  auth: { tokenHosts: ["oauth2.googleapis.com", "github.com", "login.microsoftonline.com"] }
})
