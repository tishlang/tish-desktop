{
  "name": "tish-desktop-example-file-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "tish": {
    "source": "./src/main.tish",
    "rustDependencies": {
      "tishlang_desktop": {
        "path": "../../crates/tish_desktop"
      }
    }
  },
  "scripts": {
    "build:css": "tish run --feature fs scripts/build-css.tish",
    "build:ui": "npm run build:css && vite build",
    "dev:ui": "npm run build:css && vite",
    "build:shell": "tish build --target native --native-backend rust src/main.tish -o dist/file-browser-shell",
    "dev": "node ../../cli/bin/mode.js dev --example file-browser",
    "dev:legacy": "node ../../scripts/dev-example.mjs file-browser",
    "start": "npm run build:ui && npm run build:shell && ./dist/file-browser-shell"
  },
  "dependencies": {
    "@tishlang/tish-desktop-api": "file:../../packages/desktop-api",
    "@tishlang/tish-desktop-shared": "file:../../packages/shared",
    "@tishlang/tish-desktop-ui-theme": "file:../../packages/ui-theme",
    "lattish": "4.0.3",
    "tish-tailwind": "npm:@tishlang/tish-tailwind@1.0.0"
  },
  "devDependencies": {
    "@tishlang/vite-plugin-tish": "3.10.3",
    "vite": "^6.0.0"
  }
}
