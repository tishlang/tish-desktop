{
  "name": "tish-desktop-example-hybrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "tish": {
    "source": "./src/main.tish",
    "platform": "macos",
    "surface": "webview",
    "rustDependencies": {
      "tishlang_app": {
        "path": "../../crates/tish_app"
      }
    }
  },
  "scripts": {
    "build:css": "tish run --feature fs scripts/build-css.tish",
    "dev:web": "npm run build:css && TISH_PLATFORM=web TISH_SURFACE=web vite --config vite.web.config.mjs",
    "dev:ui": "npm run build:css && TISH_PLATFORM=macos TISH_SURFACE=webview vite",
    "dev:desktop": "npm run build:shell && ./dist/hybrid-shell",
    "dev:shell": "npm run build:shell && ./dist/hybrid-shell",
    "dev:multi": "node ./scripts/dev-multi.mjs",
    "dev:hybrid": "node ./scripts/dev-hybrid.mjs",
    "dev:hybrid:rebuild": "node ./scripts/dev-hybrid.mjs --rebuild",
    "build:web": "npm run build:css && TISH_PLATFORM=web TISH_SURFACE=web vite build --config vite.web.config.mjs",
    "build:ui": "npm run build:css && TISH_PLATFORM=macos TISH_SURFACE=webview vite build",
    "build:shell": "tish build --target native --native-backend rust --check warn src/main.tish -o dist/hybrid-shell",
    "build:shell:apple": "node ./scripts/build-shell-apple.mjs",
    "check:tree": "node ./scripts/check-tree.mjs",
    "dev": "node ../../cli/bin/mode.js dev --example hybrid",
    "start": "npm run build:ui && npm run build:shell && ./dist/hybrid-shell"
  },
  "dependencies": {
    "@tishlang/tish-app-api": "file:../../packages/app-api",
    "@tishlang/tish-desktop-api": "file:../../packages/desktop-api",
    "@tishlang/tish-desktop-shared": "file:../../packages/shared",
    "@tishlang/tish-desktop-ui-theme": "file:../../packages/ui-theme",
    "lattish": "4.0.3",
    "tish-macos": "npm:@tishlang/tish-macos@1.2.0",
    "tish-tailwind": "npm:@tishlang/tish-tailwind@1.0.0"
  },
  "devDependencies": {
    "@tishlang/vite-plugin-tish": "3.10.3",
    "vite": "^6.0.0",
    "@tishlang/tish": "3.10.3"
  }
}
