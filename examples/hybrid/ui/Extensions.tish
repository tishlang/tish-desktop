/** @jsxImportSource lattish */
// Tauri webview companion — same plugin caps as nested WK DemoPane (desktop/v1).
import { createRoot, useState } from "lattish"
import { Button, Section, Badge } from "@tishlang/tish-desktop-ui-theme"
import { setPlatformFacts } from "@tishlang/tish-desktop-shared"
import { invoke } from "@tishlang/tish-app-api"
import { DEMO_TITLE } from "../app/demo.tish"

setPlatformFacts("macos", "webview")

fn Extensions() {
  let [log, setLog] = useState("Ready — clipboard / dialog / os via Tauri plugins")

  let run = (cmd, args) => {
    invoke(cmd, args === null || args === undefined ? {} : args).then((r) => {
      setLog(cmd + " → " + JSON.stringify(r))
    }, (e) => {
        setLog(cmd + " ✗ " + String(e))
      })
  }

  return <div class="p-5 font-sans text-foreground">
      <div class="flex items-center gap-2 mb-1">
        <h1 class="text-xl font-semibold tracking-tight">Tauri extensions</h1>
        <Badge>plugins</Badge>
      </div>
      <p class="text-sm text-muted-foreground mb-4">
        Desktop CapProviders backed by Tauri plugins. Nested WK in the Hybrid window
        hits the same commands through brokerInvoke.
      </p>
      <pre class="mb-4 rounded-lg border border-border bg-card p-3 text-xs text-muted-foreground whitespace-pre-wrap">
        {log}
      </pre>

      <Section title="Clipboard" hint="plugins.clipboard">
        <Button onClick={() => run("clipboard.writeText", { text: DEMO_TITLE + " · " + Date.now() })}>
          Write text
        </Button>
        <Button variant="secondary" onClick={() => run("clipboard.readText", {})}>
          Read text
        </Button>
      </Section>

      <Section title="Dialog" hint="plugins.dialog">
        <Button variant="outline" onClick={() => run("dialog.message", {
    title: DEMO_TITLE,
    message: "Hello from Tauri dialog plugin"
  })}>
          Message
        </Button>
      </Section>

      <Section title="OS" hint="plugins.os">
        <Button variant="ghost" onClick={() => run("os.info", {})}>
          OS info
        </Button>
        <Button variant="ghost" onClick={() => run("os.theme", {})}>
          Theme
        </Button>
      </Section>
    </div>
}

createRoot(document.getElementById("root")).render(Extensions)
