// AppKit chrome + WK detail (bridge → brokerInvoke). Attach under Tauri outer host.
import { SidebarWindow } from "tish:macos"
import { brokerInvoke, stateSet } from "cargo:tish_app"

fn onBridge(msg) {
  let cmd = msg.cmd
  let args = msg.args
  if (args === null) args = {}
  if (args.source === null) args.source = "webview:wk-main"
  return brokerInvoke(cmd, args)
}

export fn Sidebar() {
  let detailUrl = "http://localhost:5177/"
  return (
    <SidebarWindow title="Hybrid — Native">
      <scrollable>
        <column padding={12} gap={8}>
          <text>{"Native sidebar"}</text>
          <button
            title="Demo doc"
            onClick={() => {
              brokerInvoke("app.openDoc", { id: "demo-1", wordCount: 40, edits: 1 })
              stateSet("selection.docId", "demo-1")
            }}
          />
          <button
            title="Demo 2"
            onClick={() => {
              brokerInvoke("app.openDoc", { id: "demo-2", wordCount: 20, edits: 0 })
              stateSet("selection.docId", "demo-2")
            }}
          />
        </column>
      </scrollable>
      <webview
        id={"wk-main"}
        bridge={true}
        height={"fill"}
        src={detailUrl}
        onBridgeInvoke={onBridge}
      />
    </SidebarWindow>
  )
}
