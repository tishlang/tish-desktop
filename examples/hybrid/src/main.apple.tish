// SC4 hybrid: Native ‖ Webview + Tauri as outer host (desktop plugins).
// Nested WK uses brokerInvoke → same CapProvider surface as Tauri webviews.
import { run, handle, createSurface, stateSet } from "cargo:tishlang_app"
import { Shell } from "../app/Shell"
import { DEMO } from "../app/demo.tish"

fn scoreDoc(wordCount: number, edits: number): number {
  return wordCount * 1.5 + edits * 0.25
}

handle("app.openDoc", (args) => {
  let id = args.id
  let words: number = 0
  let edits: number = 0
  if (args.wordCount !== null) words = args.wordCount
  if (args.edits !== null) edits = args.edits
  let s: number = scoreDoc(words, edits)
  stateSet(DEMO.docId, id)
  stateSet("selection.score", s)
  return { ok: true, score: s }
})

createSurface({
  id: "main",
  kind: "native",
  title: "Hybrid",
  root: Shell
})

// Tauri companion window — keeps AppHandle / plugins alive and demos the same
// clipboard / dialog / os caps from a real Tauri webview bridge.
createSurface({
  id: "tauri-ext",
  kind: "webview",
  label: "tauri-ext",
  url: "http://localhost:5177/extensions.html",
  title: "Hybrid — Tauri extensions",
  width: 420,
  height: 520,
  titleBarStyle: "visible"
})

run({
  profile: "desktop",
  platformAttach: {
    apple: {
      outerHost: true,
      autoRunEventLoop: false
    }
  },
  plugins: {
    notification: true,
    store: true,
    clipboard: true,
    dialog: true,
    os: true,
    menu: true,
    tray: false,
    singleInstance: false
  }
})
