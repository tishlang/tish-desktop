// Pure shared helpers — safe for shell (native) and UI (JS) targets.
// No dependency on lattish or ui-theme.
export const PROTOCOL = "desktop/v1"
export {
  EVT_TICK,
  EVT_MENU_ACTION,
  EVT_TRAY_ACTION,
  EVT_DEEP_LINK,
  EVT_FS_CHANGED,
  EVT_THEME_CHANGED,
  EVT_FILE_DROP,
  EVT_AUTH_CHANGED,
  EVT_AUTH_ERROR,
  EVT_UPDATER_PROGRESS,
  EVT_STATE_CHANGED,
} from "./events.tish"
export {
  Platform,
  platformIsNative,
  platformIsWebview,
  platformIsWeb,
  platformSelect,
  setPlatformFacts,
} from "./platform.tish"

export fn joinPath(base, name) {
  if (base.endsWith("/")) return base + name
  return base + "/" + name
}

export fn parentPath(path) {
  let i = path.lastIndexOf("/")
  if (i <= 0) return path
  return path.slice(0, i)
}

export fn entrySortKey(entry) {
  let prefix = entry.kind === "dir" ? "0" : "1"
  return prefix + (entry.name || "").toLowerCase()
}
