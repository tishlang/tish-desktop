{
  "name": "@tish-desktop/desktop-api",
  "version": "0.1.0",
  "description": "UI bridge and desktopHost façade for Tish Desktop apps",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/tish-desktop.git",
    "directory": "packages/desktop-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "tish": {
    "module": "./src/desktopHost.tish"
  },
  "exports": {
    ".": { "tish": "./src/desktopHost.tish" },
    "./desktopHost": { "tish": "./src/desktopHost.tish" },
    "./bridge": { "import": "./src/bridge.js" }
  },
  "keywords": [
    "tish",
    "desktop",
    "tauri"
  ]
}
