{
  "name": "@tish-desktop/desktop-api",
  "version": "0.1.0",
  "description": "Core UI bridge and app-api façade (invoke, listen, state.*) — no UI kit dependency",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/tish-desktop.git",
    "directory": "packages/desktop-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "tish": {
    "module": "./src/appApi.tish"
  },
  "exports": {
    ".": { "tish": "./src/appApi.tish" },
    "./desktopHost": { "tish": "./src/desktopHost.tish" },
    "./appApi": { "tish": "./src/appApi.tish" },
    "./bridge": { "import": "./src/bridge.js" },
    "./web-bridge": { "import": "./src/web-bridge.js" }
  },
  "dependencies": {
    "@tish-desktop/shared": "file:../shared"
  },
  "keywords": [
    "tish",
    "desktop",
    "tauri",
    "app-api"
  ]
}
