{
  "name": "@tish-desktop/app-api",
  "version": "0.1.0",
  "description": "Alias of @tish-desktop/desktop-api — invoke, listen, state.*, Platform",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/tish-desktop.git",
    "directory": "packages/app-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "tish": {
    "module": "./src/index.tish"
  },
  "exports": {
    ".": { "tish": "./src/index.tish" },
    "./bridge": { "import": "../desktop-api/src/bridge.js" },
    "./web": { "import": "../desktop-api/src/web-bridge.js" },
    "./web-bridge": { "import": "../desktop-api/src/web-bridge.js" }
  },
  "dependencies": {
    "@tish-desktop/desktop-api": "file:../desktop-api",
    "@tish-desktop/shared": "file:../shared"
  },
  "keywords": [
    "tish",
    "app-api",
    "desktop"
  ]
}
